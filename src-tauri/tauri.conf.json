{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "harvey",
  "version": "0.1.0",
  "identifier": "com.harvey.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Harvey",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DOCUMENT/**/harvey_files/**",
          "$APP/harvey_files/**",
          "$APP/**",
          "$RESOURCE/**"
        ]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "sidecar/whisper-cli",
      "sidecar/diarize-cli",
      "sidecar/pandoc",
      "sidecar/ffmpeg",
      "sidecar/whisper-stream",
      "sidecar/translator-sidecar"
    ],
    "licenseFile": "../LICENSE.md",
    "license": "MIT",
    "resources": [
      "third_party_licenses",
      "scripts"
    ]
  }
}
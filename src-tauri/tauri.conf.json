{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harvey",
  "version": "0.1.2",
  "identifier": "com.harvey.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Harvey",
        "width": 1024,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "transparent": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$DOCUMENT/**/harvey_files/**",
          "$APP/harvey_files/**",
          "$APP/**",
          "$RESOURCE/**"
        ]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/micromamba"
    ],
    "licenseFile": "../LICENSE.md",
    "license": "MIT",
    "resources": [
      "third_party_licenses",
      "scripts/*",
      "binaries",
      "python",
      "assets/*"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    }
  }
}
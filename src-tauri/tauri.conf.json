{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "harvey",
  "version": "0.1.0",
  "identifier": "com.harvey.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Harvey",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DOCUMENT/**/harvey_files/**",
          "$APP/harvey_files/**",
          "$APP/**",
          "$RESOURCE/**"
        ]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "sidecars/whisper-cli",
      "sidecars/whisper-stream"
    ],
    "licenseFile": "../LICENSE.md",
    "license": "MIT"
  },
  "platforms": {
    "windows-x86_64": {
      "bundle": {
        "resources": [
          "third_party_licenses",
          "scripts/*",
          "sidecars",
          "binaries"
        ]
      }
    },
    "windows-arm64": {
      "bundle": {
        "resources": [
          "third_party_licenses",
          "scripts/*",
          "sidecars"
        ]
      }
    },
    "linux-x86_64": {
      "bundle": {
        "resources": [
          "third_party_licenses",
          "scripts/*",
          "sidecars",
          "binaries"
        ]
      }
    },
    "linux-arm64": {
      "bundle": {
        "resources": [
          "third_party_licenses",
          "scripts/*",
          "sidecars",
          "binaries"
        ]
      }
    },
    "macos-x86_64": {
      "bundle": {
        "resources": [
          "third_party_licenses",
          "scripts/*",
          "sidecars",
          "binaries"
        ]
      }
    },
    "macos-arm64": {
      "bundle": {
        "resources": [
          "third_party_licenses",
          "scripts/*",
          "sidecars",
          "binaries"
        ]
      }
    }
  }
}